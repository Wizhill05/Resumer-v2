# ── NextAuth / Auth.js (v5) ─────────────────────────────────
# Secret key used for session encryption & JWT signing.
# MUST match the backend JWT_SECRET so backend can verify frontend requests!
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=changeme-generate-a-random-hex-string

# Canonical URL of your Next.js frontend application (Auth.js v5 uses AUTH_URL).
# Local: http://localhost:3000
# Vercel: https://your-app-name.vercel.app (or your custom domain)
AUTH_URL=http://localhost:3000

# Required by NextAuth v5 when deploying behind reverse proxies / Vercel Edge.
AUTH_TRUST_HOST=true

# ── Backend Connection ──────────────────────────────────────
# The URL used by Next.js server (BFF proxy route / API calls) to reach FastAPI backend.
# Local: http://localhost:8000 (or http://backend:8000 inside Docker)
# Vercel: https://your-backend-railway-url.up.railway.app
# Note: You do NOT need NEXT_PUBLIC_API_URL because all frontend requests pass through
# Next.js API proxy routes (/api/backend/*).
BACKEND_INTERNAL_URL=http://localhost:8000

# ── OAuth Providers ────────────────────────────────────────
# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# Redirect URI for local: http://localhost:3000/api/auth/callback/google
# Redirect URI for Vercel: https://your-app-name.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Credentials
# Get from: https://github.com/settings/developers
# Redirect URI for local: http://localhost:3000/api/auth/callback/github
# Redirect URI for Vercel: https://your-app-name.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
