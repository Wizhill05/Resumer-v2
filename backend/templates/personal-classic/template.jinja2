<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    {% include 'personal-classic/style.css' %}
    :root {
      --resume-font-size: {{ font_size }}pt;
    }
    body      { font-size: var(--resume-font-size); }
    h1        { font-size: calc(var(--resume-font-size) * 2.4); }
    h2        { font-size: calc(var(--resume-font-size) * 1.15); }
    h3        { font-size: calc(var(--resume-font-size) * 1.1); }
    .subtitle { font-size: calc(var(--resume-font-size) * 1.35); }
    /* @page uses literal values — CSS vars are not supported in @page context */
    @page {
      margin: {{ page_margin_mm }}mm;
      margin-bottom: {{ page_margin_mm * 0.7 }}mm;
    }
    /* Simulate @page margins for browser/iframe preview (WeasyPrint ignores @media screen) */
    @media screen {
      body {
        padding: {{ page_margin_mm }}mm;
        padding-bottom: {{ page_margin_mm * 0.7 }}mm;
      }
    }
  </style>
</head>
<body>

<!-- Header -->
<div class="header-row">
  <div class="header-left">
    <h1>{{ profile.full_name or '' }}</h1>
    {% if profile.subtitle %}
    <div class="subtitle">{{ profile.subtitle }}</div>
    {% endif %}
  </div>
  <div class="header-right">
    <div>
      {% if profile.email %}✉ <a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}
      {% if profile.linkedin_url %} | <img class="social-icon" src="icons/linkedin.svg" /> <a href="{{ profile.linkedin_url }}">{{ profile.linkedin_url | replace('https://', '') | replace('http://', '') | replace('www.', '') }}</a>{% endif %}
    </div>
    <div>
      {% if profile.phone %}✆ {{ profile.phone }}{% endif %}
      {% if profile.github_url %} | <img class="social-icon" src="icons/github.svg" /> <a href="{{ profile.github_url }}">{{ profile.github_url | replace('https://', '') | replace('http://', '') | replace('www.', '') }}</a>{% endif %}
    </div>
  </div>
</div>

<!-- Body Sections dispatched dynamically by section_order -->
{% set effective_sections = section_order if section_order is defined and section_order else ['summary', 'education', 'skills', 'projects', 'experiences', 'extracurriculars'] %}
{% for section_id in effective_sections %}
  {% if section_id == 'summary' and resume.summary %}
  <!-- Summary -->
  <h2>PROFESSIONAL SUMMARY</h2>
  <p class="body-indent">{{ resume.summary | e | markdown }}</p>
  {% elif section_id == 'education' and resume.education %}
  <!-- Education -->
  <h2>EDUCATION</h2>
  {% for edu in resume.education %}
  <div class="resume-entry">
  <dl>
    <dt><strong>{{ edu.degree }}</strong> | {{ edu.institution }}{% if edu.location %}, {{ edu.location }}{% endif %}</dt>
    <dd>
      {% if edu.start_date and edu.end_date %}{{ edu.start_date | format_date }} – {{ edu.end_date | format_date }}
      {% elif edu.end_date %}{{ edu.end_date | format_date }}
      {% elif edu.start_date %}{{ edu.start_date | format_date }}{% endif %}
      {% if edu.gpa %} | GPA: {{ edu.gpa }}{% endif %}
    </dd>
  </dl>
  </div>
  {% endfor %}
  {% elif section_id == 'skills' and resume.skills %}
  <!-- Skills -->
  <h2>SKILLS</h2>
  <table class="skills-table">
  {% for category, items in resume.skills.items() %}
    <tr>
      <td>{{ category }}</td>
      <td>{{ items | join(', ') }}</td>
    </tr>
  {% endfor %}
  </table>
  {% elif section_id == 'projects' and resume.projects %}
  <!-- Projects -->
  <h2>PROJECTS</h2>
  {% for project in resume.projects %}
  {% set project_idx = loop.index0 %}
  <div class="resume-entry">
  {% set project_link = (project.github_url or project.live_url or '') | trim %}
  {% set project_summary = (project.project_summary or '') | trim %}
  {% set link_label = project_link | replace('https://', '') | replace('http://', '') | replace('www.', '') | replace('github.com/', '') %}
  <dl>
    <dt>
      <strong>{{ project.name }}
      {%- if project_summary %} | {{ project_summary | e | markdown }}{% endif %}
      {%- if project_link %} | <a href="{{ project_link if project_link.startswith('http') else 'https://' + project_link }}">{{ link_label }}</a>{% endif %}
      </strong>
    </dt>
    <dd></dd>
  </dl>
  {% set non_empty_bullets = (project.bullet_points or []) | select | map("trim") | select | list %}
  {% if non_empty_bullets %}
  <ul>
  {% for bullet in (project.bullet_points or []) %}
  {% if bullet and bullet | trim %}
    <li data-section="projects" data-entry-idx="{{ project_idx }}" data-bullet-idx="{{ loop.index0 }}">{{ bullet | e | markdown }}</li>
  {% endif %}
  {% endfor %}
  </ul>
  {% elif project.description %}
  <p class="body-indent">{{ project.description | e | markdown }}</p>
  {% endif %}
  </div>
  {% endfor %}
  {% elif section_id == 'experiences' and resume.experiences %}
  <!-- Experience -->
  <h2>EXPERIENCE</h2>
  {% for exp in resume.experiences %}
  {% set exp_idx = loop.index0 %}
  <div class="resume-entry">
  <dl>
    <dt><strong>{{ exp.role }} | {{ exp.organization }}{% if exp.location %} | {{ exp.location }}{% endif %}</strong></dt>
    <dd>
      {% if exp.start_date %}{{ exp.start_date | format_date }}{% endif %}
      {% if exp.start_date and exp.end_date %} – {% endif %}
      {% if exp.end_date %}{{ exp.end_date | format_date }}{% else %}Present{% endif %}
    </dd>
  </dl>
  <ul>
  {% for bullet in exp.bullet_points %}
    <li data-section="experience" data-entry-idx="{{ exp_idx }}" data-bullet-idx="{{ loop.index0 }}">{{ bullet | e | markdown }}</li>
  {% endfor %}
  </ul>
  </div>
  {% endfor %}
  {% elif section_id == 'extracurriculars' and resume.extracurriculars %}
  <!-- Extra-Curricular Activities & Achievements -->
  <h2>EXTRA-CURRICULAR ACTIVITIES & ACHIEVEMENTS</h2>
  <div class="extracurriculars-section">
    <ul>
    {% for ex in resume.extracurriculars %}
      <li data-section="extracurriculars" data-entry-idx="{{ loop.index0 }}" data-bullet-idx="0">{{ ex.description | e | markdown }}</li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}
{% endfor %}

</body>
</html>
