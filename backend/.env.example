DATABASE_URL=postgresql+psycopg://user:pass@localhost/resumer
# Must match frontend NEXTAUTH_SECRET because backend verifies frontend proxy tokens with it.
JWT_SECRET=your-shared-secret-here
FRONTEND_URL=http://localhost:3000

# Cerebras API — primary provider, comma-separated for round-robin (5 calls/min/key)
CEREBRAS_API_KEYS=your-cerebras-key-1,your-cerebras-key-2

# Google Gemini API — fallback if Cerebras call fails
# Comma-separated for round-robin load balancing
GOOGLE_API_KEYS=your-google-key-1,your-google-key-2

# Cloudflare R2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resumer-artifacts

# Email notifications (Resend — free 3k/mo)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Resumer <noreply@yourdomain.com>

# Pipeline execution mode (only "local" supported — Railway keeps the process alive)
EXECUTION_MODE=local

# Comma-separated admin email allowlist. Use * only for local trusted dev.
ADMIN_EMAILS=admin@example.com
