DATABASE_URL=postgresql+psycopg://user:pass@localhost/resumer
JWT_SECRET=your-nextauth-secret-here
FRONTEND_URL=http://localhost:3000

# Groq API — comma-separated for round-robin load balancing across multiple keys
# Get keys at console.groq.com. Single key also works: GROQ_API_KEYS=gsk_...
GROQ_API_KEYS=gsk_your-key-1,gsk_your-key-2

# Cloudflare R2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resumer-artifacts

# Email notifications (Resend — free 3k/mo)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Resumer <noreply@yourdomain.com>

# Pipeline execution mode (only "local" supported — Railway keeps the process alive)
EXECUTION_MODE=local
