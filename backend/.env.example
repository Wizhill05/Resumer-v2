# ── Database ────────────────────────────────────────────────
# Local PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resumer

# ── Auth / JWT ──────────────────────────────────────────────
# Shared secret with frontend (NEXTAUTH_SECRET). They MUST match.
# Generate one with: openssl rand -hex 32
JWT_SECRET=changeme-generate-a-random-hex-string

# ── URLs & Public Endpoints ────────────────────────────────────
# Frontend URL used for CORS allow-origin.
FRONTEND_URL=http://localhost:3000
# Public backend URL used for generating clean MCP resume download links.
BACKEND_URL=https://resumer-backend.aryansingh.space
# Lifetime for public HMAC file download links in hours (default: 168 = 7 days)
FILE_LINK_TTL_HOURS=168
# ── AI Provider Keys ───────────────────────────────────────
# OpenRouter primary/free and independent fallback (comma-separated keys)
OPENROUTER_API_KEYS=sk-or-v1-your-key-1,sk-or-v1-your-key-2

# Pro Tier LLM Provider (OmniRoute Gemini)
PRO_MODEL_BASE_URL=https://omniroute-latest-rmm0.onrender.com/
PRO_MODEL_NAME=gemini-3.8-flash-tiered
PRO_MODEL_API_KEY=
PRO_MODEL_API_KEYS=
# ── Cloudflare R2 (S3-compatible object storage) ───────────
# Used to store generated PDF resumes.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=resumer-artifacts

# ── Email Notifications (Resend) ──────────────────────────
# Optional — used for sending notification emails.
# Free tier: 3,000 emails/month at https://resend.com
RESEND_API_KEY=re_your-resend-api-key
NOTIFICATION_FROM_EMAIL=Resumer <noreply@yourdomain.com>

# ── Pipeline Execution ─────────────────────────────────────
# Only "local" is supported for self-hosting.
EXECUTION_MODE=local

# ── Admin & Rate-Limiting ──────────────────────────────────
# Comma-separated admin email allowlist. Use * for local dev only.
ADMIN_EMAILS=admin@example.com
DEFAULT_DAILY_CAP=5
DEFAULT_MONTHLY_CAP=150

# ── Feature Flags ──────────────────────────────────────────
ENABLE_RESUME_EDITOR=true

FREE_MODEL_NAME=google/gemini-3.8-flash
FREE_MODEL_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=google/gemini-3.8-flash
# Explicit output cap avoids reserving the provider's entire context/output allowance.
LLM_MAX_OUTPUT_TOKENS=8192
