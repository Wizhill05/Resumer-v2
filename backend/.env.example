# Set to production in prod so verification codes are never printed to logs when RESEND_API_KEY is missing.
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────
# Local PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resumer

# ── Auth / JWT ──────────────────────────────────────────────
# Shared secret with frontend (NEXTAUTH_SECRET). They MUST match.
# Generate one with: openssl rand -hex 32
JWT_SECRET=changeme-generate-a-random-hex-string
# Signs short-lived internal JWTs for /internal/auth/resolve (must match frontend).
INTERNAL_API_SECRET=
# Fernet key for encrypting stored GitHub OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GITHUB_TOKEN_KEY=
# Separate "Connect GitHub" OAuth App for linking + private-repo opt-in.
# Its Authorization Callback URL must be the frontend route below.
GITHUB_CONNECT_CLIENT_ID=
GITHUB_CONNECT_CLIENT_SECRET=
GITHUB_CONNECT_REDIRECT_URI=https://resumer.buzz/api/integrations/github/callback

# ── URLs & Public Endpoints ────────────────────────────────────
# Frontend URL used for CORS allow-origin.
# In production set this to https://resumer.buzz
FRONTEND_URL=http://localhost:3000
# Public backend URL used for generating clean MCP resume download links.
BACKEND_URL=https://api.resumer.buzz
# Lifetime for public HMAC file download links in hours (default: 168 = 7 days)
FILE_LINK_TTL_HOURS=168
# ── LLM ───────────────────────────────────────────────
# Endpoints are configured in Admin → LLM Endpoints (any OpenAI-compatible API).
# Optional: Fernet key for encrypting stored tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())").
# If unset, a key is derived from JWT_SECRET (rotating JWT_SECRET then requires re-entering tokens).
LLM_SECRET_KEY=
# Optional one-time bootstrap: seeds one endpoint + the default role when no endpoints exist.
LLM_BOOTSTRAP_NAME=Primary
LLM_BOOTSTRAP_BASE_URL=
LLM_BOOTSTRAP_API_KEY=
LLM_BOOTSTRAP_MODEL=
# ── Cloudflare R2 (S3-compatible object storage) ───────────
# Used to store generated PDF resumes.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=resumer-artifacts

# ── Email Notifications (Resend) ──────────────────────────
# Optional — used for sending notification emails.
# Free tier: 3,000 emails/month at https://resend.com
RESEND_API_KEY=re_your-resend-api-key
NOTIFICATION_FROM_EMAIL=Resumer <noreply@yourdomain.com>

# Cloudflare Turnstile (guest support form). If TURNSTILE_SECRET_KEY is unset verification is skipped.
TURNSTILE_SECRET_KEY=

# Web Push (VAPID) for support reply notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@yourdomain.com

# ── Pipeline Execution ─────────────────────────────────────
# Only "local" is supported for self-hosting.
EXECUTION_MODE=local

# ── Admin & Rate-Limiting ──────────────────────────────────
# Comma-separated admin email allowlist. Use * for local dev only.
ADMIN_EMAILS=admin@example.com
DEFAULT_DAILY_CAP=5
DEFAULT_MONTHLY_CAP=150

# ── Guest trial (/try) abuse limits ────────────────────────
# Daily per-IP caps protect against cookieless clients that get a fresh token
# per request. Requires INTERNAL_API_SECRET and X-Client-IP forwarding.
GUEST_GENERATE_DAILY_PER_IP=10
GUEST_IMPORT_DAILY_PER_IP=15
GUEST_IMPORT_DAILY_PER_TOKEN=10
# Global daily cap on guest generations (all tokens). 0 disables.
GUEST_DAILY_GLOBAL_CAP=300
# Enforce Turnstile on guest generate/import (also needs TURNSTILE_SECRET_KEY).
# Only turn on after NEXT_PUBLIC_TURNSTILE_SITE_KEY is set on Vercel, or every
# guest generation will fail the check.
GUEST_TURNSTILE_REQUIRED=false

# ── Feature Flags ──────────────────────────────────────────
ENABLE_RESUME_EDITOR=true

# Explicit output cap avoids reserving the provider's entire context/output allowance.
LLM_MAX_OUTPUT_TOKENS=8192

# PostHog uses the browser project token, never a personal CLI API key.
# Set environment=production only on the deployed backend.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENVIRONMENT=development
# Admin overview reads metrics back from PostHog. Create a personal API key with the
# "Query: read" scope (PostHog > Settings > Personal API keys) and copy the numeric
# project id from the project settings URL. Leave empty to hide the PostHog panels.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional. Defaults to POSTHOG_HOST with ".i.posthog.com" swapped for ".posthog.com".
POSTHOG_API_HOST=
