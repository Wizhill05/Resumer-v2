DATABASE_URL=postgresql+psycopg://user:pass@localhost/resumer
JWT_SECRET=your-nextauth-secret-here
FRONTEND_URL=http://localhost:3000

# Gemini API — comma-separated for round-robin load balancing across multiple keys
# Single key also works: GOOGLE_API_KEYS=your-key
GOOGLE_API_KEYS=your-key-1,your-key-2,your-key-3

# Cloudflare R2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resumer-artifacts

# Email notifications (Resend — free 3k/mo)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Resumer <noreply@yourdomain.com>

# Pipeline execution mode (only "local" supported — Railway keeps the process alive)
EXECUTION_MODE=local
